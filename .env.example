# Database Connection (Bisa pakai DB_DSN langsung dari TiDB Cloud, atau parameter terpisah)
# Opsi 1 - TiDB Cloud Go DSN langsung:
# DB_DSN=username:password@tcp(gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000)/database_name?tls=true

# Opsi 2 - Parameter terpisah:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=todo_db
DB_USERNAME=root
DB_PASSWORD=
DB_TLS=false

# App & Auth
JWT_SECRET=super-secret-jwt-key
PORT=8080
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=

# External API & AI Keys (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=